{
  "name": "jassub",
  "version": "2.5.20",
  "description": "The Fastest JavaScript SSA/ASS Subtitle Renderer For Browsers",
  "main": "dist/jassub.js",
  "type": "module",
  "files": [
    "dist/wasm/*",
    "dist/worker/*",
    "dist/jassub.*",
    "dist/debug.*",
    "dist/default.woff2",
    "!dist/wasm/jassub-worker-modern.js",
    "README.md",
    "LICENSE",
    "index.d.ts",
    "src/**/*.ts",
    "!src/default.woff2"
  ],
  "scripts": {
    "build": "tsc --noCheck",
    "dev": "vite --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t thaunknown/jassub-build .",
    "docker:run": "docker run -it --rm -v ${PWD}:/code --name thaunknown_jassub-build thaunknown/jassub-build:latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThaUnknown/jassub.git"
  },
  "keywords": [
    "libass",
    "subtitle",
    "wasm",
    "emscripten",
    "ASS",
    "WebAssembly",
    "subtitles",
    "webgpu",
    "webgl2",
    "typescript"
  ],
  "author": "ThaUnknown",
  "license": "LGPL-2.1-or-later AND (FTL OR GPL-2.0-or-later) AND MIT AND MIT-Modern-Variant AND ISC AND NTP AND Zlib AND BSL-1.0",
  "bugs": {
    "url": "https://github.com/ThaUnknown/jassub/issues"
  },
  "homepage": "https://github.com/ThaUnknown/jassub",
  "dependencies": {
    "abslink": "^1.3.1",
    "lfa-ponyfill": "^1.1.1",
    "rvfc-polyfill": "^1.0.8",
    "throughput": "^1.0.2"
  },
  "devDependencies": {
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@webgpu/types": "^0.1.74",
    "eslint-config-standard-universal": "^1.0.10",
    "jassub-ref": "npm:jassub@1.8.8",
    "playwright": "^1.63.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vitest": "^5.0.3"
  }
}